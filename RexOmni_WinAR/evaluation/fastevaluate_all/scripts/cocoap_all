#!/usr/bin/env python
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
import fastevaluate_all as fe


def main():
    if len(sys.argv) != 4:
        raise SystemExit("usage: cocoap_all GT_PATH PRED_PATH EVAL_TYPE")

    gt_path, pred_path, eval_type = sys.argv[1:]
    if eval_type not in ("coco", "cocomask", "lvis", "lvismask"):
        raise SystemExit(f"unsupported eval type: {eval_type}")

    fe.evaluate(
        gt_path,
        pred_path,
        0,  # category-aware evaluation
        0,  # include every score
        eval_type,
    )


if __name__ == "__main__":
    main()
